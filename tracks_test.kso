import "./given"
import "kanso-lang/senro/visit"
import "std/expect"
import "std/list"
import "std/spec"
import "std/text"

# The tracks, asked for as a browser asks. `senro test` runs these against
# the test database, and each example runs in a transaction that is rolled
# back, so none of them sees what another wrote.
test_tracks = describe "tracks" [
  around (visit/within routes connected)
  it "are listed" listed
  it "are made from the form and shown" made
  it "go after the album's last" appended
  it "are listed in the order they are dragged into" reordered
  it "are changed from the form" changed
  it "are not made from a field that breaks its rule" refused
  it "are gone once removed" removed
]

fn listed v
  tracks_path v
    .> (at -> visit/get v at)
    .> (v -> effect (expect v.status . to (equal 200)))

fn made v
  tracks_path v
    .> (at -> visit/post v at given/track)
    .> (v -> visit/followed v)
    .> (v -> effect (expect v.body . to (contain "milk")))

# Nobody types a track's place: the second one added is track 2.
fn appended v
  tracks_path v
    .> (at -> visit/post v at given/track .> (w -> visit/post w at given/track))
    .> (v -> visit/followed v)
    .> (v -> effect (expect v.body . to (contain "Track 2")))

# Three tracks, and the third dragged to the top, as the page sends it:
# only its new place. The list then starts with it, and the first is now
# second.
fn reordered v
  tracks_path v
    .> (at -> topped v at)
    .> (v -> effect (expect (listed_first v.body) . to (equal "cadenza")))

fn topped v at
  three v at
    .> (w -> visit/patch w (visit/location w) to_top)
    .> (w -> visit/get w at)

fn three v at
  visit/post v at (titled "aubade")
    .> (w -> visit/post w at (titled "barcarolle"))
    .> (w -> visit/post w at (titled "cadenza"))

fn titled t
  put given/track "title" t

to_top = { "position":"1" }

# The title of the first track the list shows.
fn listed_first body
  after = text/split body "data-reorder"
  return "" if length after < 2
  first_link (text/split after[2] "</a>")

fn first_link pieces
  return "" if length pieces < 1
  last_of (text/split pieces[1] ">")

fn last_of parts
  text_of (list/last parts)

fn text_of none
  ""

fn text_of t
  t

fn changed v
  tracks_path v
    .> (at -> visit/post v at given/track)
    .> (v -> visit/patch v (visit/location v) edited)
    .> (v -> visit/followed v)
    .> (v -> effect (expect v.body . to (contain "bread")))

fn refused v
  tracks_path v
    .> (at -> visit/post v at broken)
    .> (v -> effect (expect v.status . to (equal 422)))

fn removed v
  tracks_path v
    .> (at -> visit/post v at given/track)
    .> (v -> gone v (visit/location v))

fn gone v at
  visit/remove v at
    .> (v -> visit/get v at)
    .> (v -> effect (expect v.status . to (equal 404)))

# A album for an example's tracks to sit under, and the path to them.
# An album belongs to an artist, so the artist is made first.
fn tracks_path v
  artist/create v.db given/artist
    .> (a -> album/create v.db (put given/album "artist_id" "{a.id}"))
    .> (n -> effect "/albums/{n.id}/tracks")

edited = put given/track "title" "bread"

broken = put given/track "title" ""
