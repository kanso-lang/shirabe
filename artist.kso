# An artist is a row of the `artists` table. This module is named for it, so
# the models derivation declares `artist` here with a field for each column
# and answers for the table by this module's name: `artist/find db id`,
# `artist/paged db number per`, `artist/create db fields` and the rest.
#
# Only the account that made an artist sees it, changes it or removes it, and
# it can only be made as that account's own.
pub fn create? viewer r
  r.owner == viewer

pub fn update? viewer r
  r.owner == viewer

pub fn destroy? viewer r
  r.owner == viewer

pub fn visible? viewer r
  r.owner == viewer
