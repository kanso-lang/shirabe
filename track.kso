import "kanso-lang/senro/models"

# A track is a row of the `tracks` table. This module is named for it, so
# the models derivation declares `track` here with a field for each column
# and answers for the table by this module's name: `track/find db id`,
# `track/paged db number per`, `track/create db fields` and the rest.
#
# Only the account that made a track sees it, changes it or removes it, and
# it can only be made as that account's own.
pub fn create? viewer r
  r.owner == viewer

pub fn update? viewer r
  r.owner == viewer

pub fn destroy? viewer r
  r.owner == viewer

# What makes a track fit to keep: a title, and the place on its album that
# `tracks/create` gives it, which is a whole number.
pub fn problems r
  models/problems [
    (models/present "title" r.title)
    (models/whole_number "position" r.position)
  ]
