import "./album"
import "./track"
import "./views"
import "kanso-lang/senro/models"
import "kanso-lang/senro/routes"
import "kanso-lang/senro/web"
import "std/list"
import "std/net/http"
import "std/text"

# A row of `tracks` belongs to a album, so each action takes the album's id
# and the routes nest under it: `index` answers GET
# /albums/:album_id/tracks. A row is found only under its own album, and a
# album that is not there has none to list or make.
pub fn index req db album_id:int
  album/find db album_id .> (a -> listed req db (own req a))

# An album's tracks in their order on it, with the album's artist for the
# link back, since an album's own pages nest under its artist.
fn listed _ _ none
  effect http/not_found

fn listed req db a
  in_order db a.id .> (rows -> effect (listing req a rows))

# An album's tracks, first to last.
fn in_order db album_id
  track/paged db "album_id" album_id 1 album_most
    .> (p -> effect (list/to_list (list/sort_by p.rows (r -> r.position))))

# A track's page is shared with its album, so it asks for no sign-in. It is
# there for whoever may see the album, and its owner's buttons are for the
# owner alone.
pub without_sign_in = ["show"]

pub fn show req db album_id:int id:int
  album/find db album_id .> (a -> heard req db a id)

fn heard _ _ none _
  effect http/not_found

fn heard req db a id
  track/find (models/as_app db) id .> (r -> effect (shown req a (owned a.id r)))

pub fn new req db album_id:int
  path = listed_path album_id
  within req db album_id (effect (form req path "POST" blank {} 200))

# A new track goes after the album's last, so an album plays in the order
# its tracks were added, and nobody types a number.
pub fn create req db album_id:int
  theirs = put (sent (web/input req)) "owner" (web/viewer req)
  given = put theirs "album_id" "{album_id}"
  numbered = (rows -> track/create db (put given "position" (next rows)))
  making = in_order db album_id .> numbered
  made_of = (w -> effect (made req album_id w))
  within req db album_id (making .> made_of)

# More tracks than any album holds, so one page reads them all.
album_most = 1000

fn next rows
  last = list/fold rows 0 (n r -> if (r.position > n) r.position n)
  "{last + 1}"

pub fn edit req db album_id:int id:int
  under db album_id id .> (r -> effect (editing req album_id id r))

pub fn update req db album_id:int id:int
  f = web/input req
  under db album_id id
    .> (r -> updating db id f r)
    .> (w -> effect (changed req album_id id w))

pub fn destroy _ db album_id:int id:int
  under db album_id id
    .> (r -> removing db id r)
    .> (w -> effect (gone album_id w))

# `then` when the album is there and the viewer's own, and a 404 when it is
# not: a public album is listened to, and only its owner adds to it.
fn within req db id then
  album/find db id .> (found -> held (own req found) then)

# The album when it is the viewer's, or none.
fn own _ none
  none

fn own req a
  if (a.owner == web/viewer req) a none

fn held none _
  effect http/not_found

fn held _ then
  then

# The row with this id under this album, or none.
fn under db album_id id
  track/find db id .> (r -> effect (owned album_id r))

fn owned _ none
  none

fn owned album_id r
  if ("{r.album_id}" == "{album_id}") r none

# A write to a row under another album finds nothing.
fn updating _ _ _ none
  effect web/absent

# A track dragged to another place on its album sends only that place;
# its form sends its title and audio.
fn updating db id f r
  sent_to db id f r (text/to_int (web/value f "position"))

fn sent_to db id f _ none
  track/update db id (picked f)

fn sent_to db _ _ r to
  moved db r to

# The album's tracks renumbered with this one at `to`, and the others in
# the order they had, closing the gap it left.
fn moved db r to
  in_order db r.album_id
    .> (rows -> renumbered db (placed (others rows r.id) r to))
    .> (_ -> effect r)

fn others rows id
  list/to_list (list/reject rows (x -> x.id == id))

fn placed rest r to
  at = list/max [1 (list/min [to (length rest + 1)])]
  ahead = list/to_list (list/take rest (at - 1))
  after = list/to_list (list/drop rest (at - 1))
  list/concat (push ahead r) after

fn renumbered db rows
  places = list/to_list (list/take list/naturals (length rows))
  each = (so_far n -> so_far .> (_ -> renumber db rows[n] n))
  list/fold places (effect 0) each

fn renumber _ none _
  effect 0

fn renumber db r n
  return effect 0 if r.position == n
  track/update db r.id { "position":"{n}" }

fn removing _ _ none
  effect web/absent

fn removing db id _
  track/destroy db id

fn listed_path album_id
  routes/path_to "tracks/index" album_id

fn shown_path album_id id
  routes/path_to "tracks/show" album_id id

fn listing req a rows
  as_json = track/track_attributes
  mapped = list/to_list (list/map rows as_json)
  return web/json 200 mapped if web/wants_json? req
  page = views/tracks_index_view a.id a.artist_id rows
  views/answer req 200 "Tracks" page

fn shown _ _ none
  http/not_found

fn shown req a record
  attributes = track/track_attributes record
  return web/json 200 attributes if web/wants_json? req
  mine = record.owner == web/viewer req
  page = views/tracks_show_view record a.artist_id mine
  views/answer req 200 "Track" page

fn editing _ _ _ none
  http/not_found

fn editing req album_id id record
  form req (shown_path album_id id) "PATCH" (filled record) {} 200

fn made req album_id w:models/invalid
  path = listed_path album_id
  form req path "POST" (filled w.record) w.problems 422

fn made _ _ w:web/denied
  web/refusal w

fn made _ album_id w
  web/redirect (shown_path album_id w.id)

fn changed req album_id id w:models/invalid
  path = shown_path album_id id
  form req path "PATCH" (filled w.record) w.problems 422

fn changed _ _ _ w:web/denied
  web/refusal w

fn changed _ _ _ w:web/absent
  web/refusal w

fn changed _ album_id id _
  web/redirect (shown_path album_id id)

fn gone _ w:web/denied
  web/refusal w

fn gone _ w:web/absent
  web/refusal w

fn gone album_id _
  web/redirect (listed_path album_id)

# The form a track is made and changed with: its fields as typed, and the
# problem with each, if any.
fn form req path method fields problems code
  page = views/tracks_form_view path method fields problems
  views/answer req code "Track" page

blank = { "audio":"" "title":"" }

fn filled r
  { "audio":"{r.audio}" "title":"{r.title}" }

fn picked f
  without_empty_files (sent f) ["audio"]

fn sent f
  { "audio":(web/value f "audio") "title":(web/value f "title") }

fn without_empty_files given names
  list/fold names given (m n -> if (m[n] == "") (delete m n) m)
