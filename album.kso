import "kanso-lang/senro/models"

# A album is a row of the `albums` table. This module is named for it, so
# the models derivation declares `album` here with a field for each column
# and answers for the table by this module's name: `album/find db id`,
# `album/paged db number per`, `album/create db fields` and the rest.
#
# Only the account that made an album sees it, changes it or removes it, and
# it can only be made as that account's own.
pub fn create? viewer r
  r.owner == viewer

pub fn update? viewer r
  r.owner == viewer

pub fn destroy? viewer r
  r.owner == viewer

# Anyone may see a public album, which is how it is shared.
pub fn visible? viewer r
  r.owner == viewer or r.public == 1

# What makes a album fit to keep: each number is one its column takes.
pub fn problems r
  models/problems [(models/whole_number "year" r.year)]
