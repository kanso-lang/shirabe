takes artist_id row
p.mb-2
  a.text-secondary href=(path_to "artists/index") All artists
h1.mb-4 = row.name
div.d-flex.gap-2
  a.btn.btn-primary href=(path_to "albums/index" artist_id) Albums
  a.btn.btn-outline-secondary href=(path_to "artists/edit" row.id) Edit
  form method="post" action=(path_to "artists/destroy" row.id)
    input type="hidden" name="_method" value="DELETE"
    button.btn.btn-link.text-secondary Delete
