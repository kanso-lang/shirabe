takes row
header
  h1 Artist {row.id}
  p.lede
    a href=(path_to "artists/index") All artists
dl
  dt name
  dd = row.name
p
  a href=(path_to "artists/edit" row.id) Edit
form method="post" action=(path_to "artists/destroy" row.id)
  input type="hidden" name="_method" value="DELETE"
  button Delete
