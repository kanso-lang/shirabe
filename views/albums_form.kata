takes path method fields problems
header
  h1 Album
  p.lede
    a href=path Back
form method="post" action=path
  input type="hidden" name="_method" value=method
  label
    | title
    input name="title" value=fields["title"]
  if problems["title"] != none
    p.problem = problems["title"]
  label
    | year
    input name="year" value=fields["year"]
  if problems["year"] != none
    p.problem = problems["year"]
  button Save
