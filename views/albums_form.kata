takes path method fields problems
div.row
  div.col-lg-7
    p.mb-2
      a.text-secondary href=path Back
    h1.mb-4 Album
    form method="post" action=path
      input type="hidden" name="_method" value=method
      div.mb-3
        label.form-label for="title" Title
        input.form-control id="title" name="title" value=fields["title"]
        if problems["title"] != none
          p.problem = problems["title"]
      div.mb-3
        label.form-label for="year" Year
        input.form-control id="year" name="year" type="number" value=fields["year"]
        if problems["year"] != none
          p.problem = problems["year"]
      div.form-check.mb-4
        if fields["public"] == "1"
          input.form-check-input id="public" type="checkbox" name="public" value="1" checked="checked"
        if fields["public"] != "1"
          input.form-check-input id="public" type="checkbox" name="public" value="1"
        label.form-check-label for="public" Public: anyone with the album's link can listen
      button.btn.btn-primary Save
