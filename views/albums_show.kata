takes row
header
  h1 Album {row.id}
  p.lede
    a href=(path_to "albums/index" row.artist_id) All albums
dl
  dt title
  dd = row.title
  dt year
  dd = row.year
p
  a href=(path_to "albums/edit" row.artist_id row.id) Edit
form method="post" action=(path_to "albums/destroy" row.artist_id row.id)
  input type="hidden" name="_method" value="DELETE"
  button Delete
