takes notice problems
div.row.justify-content-center
  div.col-md-7.col-lg-5
    h1.mb-2 Forgot your password?
    p.mb-4
      a.text-secondary href=(path_to "session/new") Back to signing in
    if notice != ""
      p.notice.mb-4 = notice
    div.card
      div.card-body.p-4
        form method="post" action=(path_to "resets/create")
          div.mb-4
            label.form-label for="email" The address your account has
            input.form-control id="email" type="email" name="email" required="required"
            if problems["email"] != none
              p.problem = problems["email"]
          button.btn.btn-primary.w-100 Send me a link
