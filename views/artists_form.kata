takes path method fields problems
div.row
  div.col-lg-7
    p.mb-2
      a.text-secondary href=(path_to "artists/index") Back
    h1.mb-4 Artist
    form method="post" action=path
      input type="hidden" name="_method" value=method
      div.mb-3
        label.form-label for="name" Name
        input.form-control id="name" name="name" value=fields["name"]
        if problems["name"] != none
          p.problem = problems["name"]
      button.btn.btn-primary Save
