takes rows number more
div.d-flex.align-items-end.justify-content-between.mb-4
  div
    h1.mb-1 Artists
  a.btn.btn-primary href=(path_to "artists/new") New artist
div.list-group
  each rows r ->
    a.list-group-item.list-group-item-action.py-3 href=(path_to "artists/show" r.id) = r.name
nav.mt-4.d-flex.gap-3
  if number > 1
    a href="?page={number - 1}" Previous page
  if more
    a href="?page={number + 1}" Next page
