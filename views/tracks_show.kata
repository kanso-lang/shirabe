takes row
header
  h1 Track {row.id}
  p.lede
    a href=(path_to "tracks/index" row.album_id) All tracks
dl
  dt title
  dd = row.title
  dt position
  dd = row.position
  dt audio
  dd
    if row.audio != ""
      a href=(blob_path row.audio) open
p
  a href=(path_to "tracks/edit" row.album_id row.id) Edit
form method="post" action=(path_to "tracks/destroy" row.album_id row.id)
  input type="hidden" name="_method" value="DELETE"
  button Delete
