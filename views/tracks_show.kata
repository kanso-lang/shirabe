takes row
p.mb-2
  a.text-secondary href=(path_to "tracks/index" row.album_id) All tracks
h1.mb-1 = row.title
p.lede.mb-4 Track {row.position}
if row.audio != ""
  div.card.mb-4
    div.card-body
      audio.w-100 controls="controls" preload="metadata" src=(blob_path row.audio)
div.d-flex.gap-2
  a.btn.btn-outline-secondary href=(path_to "tracks/edit" row.album_id row.id) Edit
  form method="post" action=(path_to "tracks/destroy" row.album_id row.id)
    input type="hidden" name="_method" value="DELETE"
    button.btn.btn-link.text-secondary Delete
